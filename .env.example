# ==============================================================================
# BUDIGO ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to:
#   - .env.development (for local development)
#   - .env.test        (for test executions)
#   - .env.production  (for production deployments)
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER & APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
CORS_ORIGIN=https://budigo.app,https://api.budigo.app

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL & AUTHENTICATION
# ------------------------------------------------------------------------------
# Obtain from your Supabase Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Production requirement: Minimum 32 characters, secure random string
JWT_SECRET=super-secure-budigo-jwt-secret-key-min-32-chars-for-prod
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# GOOGLE MAPS PLATFORM APIS
# ------------------------------------------------------------------------------
# Client-side Google Maps SDK Key (Restrict by Android SHA-1 fingerprint / iOS bundle ID)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# Server-side Privileged Keys (Restrict by Server IP address in Google Cloud Console)
# Used for Routes computeRouteMatrix and Route calculation
GOOGLE_ROUTES_API_KEY=AIzaSy...
# Used for Places API (Nearby Search & Place Details for candidate meeting points)
GOOGLE_PLACES_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# MOBILE APP EXPO CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# Base API and Socket.IO endpoints accessible by the mobile devices / simulators
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# PUSH NOTIFICATIONS
# ------------------------------------------------------------------------------
# Optional: Expo Access Token for high-throughput push delivery
EXPO_ACCESS_TOKEN=your-expo-access-token
